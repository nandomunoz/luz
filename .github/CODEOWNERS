# LUZ Design System — Code Owners

# Default owner for all files in the repository
* @nandomunoz

# CI/CD and GitHub configuration
.github/workflows/      @nandomunoz
.github/                @nandomunoz

# Design tokens (base layer)
packages/tokens/        @nandomunoz
scripts/build-tokens.js @nandomunoz

# Core design system (builds on tokens)
packages/core/          @nandomunoz
scripts/build-core.js   @nandomunoz
# A language file runs on every page that declares its language: reviewed on its own line
packages/core/src/i18n* @nandomunoz

# Catalog layer (builds on core)
packages/catalog/      @nandomunoz
scripts/build-catalog.js @nandomunoz

# The shared builder of catalog
scripts/build-package.js @nandomunoz

# Dev tools (published, no CSS; own version, out of the fixed group)
packages/check/          @nandomunoz
scripts/build-check.js   @nandomunoz

# Build and configuration
scripts/                @nandomunoz
package.json            @nandomunoz
pnpm-workspace.yaml     @nandomunoz

# Documentation
*.md                    @nandomunoz
docs/                   @nandomunoz
apps/docs/              @nandomunoz
# The docs site generator writes every published page, its CSP and its links
